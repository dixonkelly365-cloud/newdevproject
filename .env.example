# --- Gemini (free, no card ever) — writes real, factual money/finance
# scripts, unlimited unique topics.
# Get one in 2 minutes: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Pexels (free, no card) — real photos for the Ken Burns effect.
# Get one in 2 minutes: https://www.pexels.com/api/ ---
PEXELS_API_KEY=

# --- Amazon Associates (optional) — REQUIRED for the affiliate link to
# actually earn commission (without it, the link still works but isn't
# tagged to you). Sign up free at https://affiliate-program.amazon.com/
# Each video links to a real Amazon search genuinely related to that
# video's specific topic, never a fabricated product claim. ---
AMAZON_ASSOCIATE_TAG=

# --- YouTube upload — same channel/credentials as your other repo on
# this account. See README for the one-time OAuth setup if starting fresh.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8085/oauth2callback
YOUTUBE_REFRESH_TOKEN=

# --- Video settings ---
FPS=30
WIDTH=1080
HEIGHT=1920
BURN_CAPTIONS=true
BACKGROUND_MUSIC=true
CINEMATIC_LOOK=true
NARRATOR_VOICE=en-US-JennyNeural
AB_SPLIT_PHOTOS=true

# --- Local testing only ---
PIPELINE_AUTO_UPLOAD=false
